{
  "name": "tsc-links-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "sync": "svelte-kit sync",
    "openapi-ts": "openapi-ts",
    "sync-api": "bash ../scripts/sync-api.sh",
    "check-api": "bash ../scripts/check-api-codegen.sh",
    "build": "bash ../scripts/sync-api.sh && svelte-kit sync && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && bun run check-api && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.1.48",
    "better-auth": "^1.7.10",
    "cn": "^0.2.6",
    "ky": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hey-api/openapi-ts": "0.97.1",
    "@lucide/svelte": "^1.48.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.5.0",
    "bits-ui": "^2.18.0",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "shadcn-svelte": "^1.6.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "svelte-sonner": "^1.1.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
