# Axum server (cargo run --bin main).
# PORT=5779
# LISTEN_ADDR=0.0.0.0

# Vite dev proxy target override (frontend/proxy.ts).
# AXUM_DEV_ORIGIN=http://127.0.0.1:5779

# Postgres. Used by `main`, `vercel`, `migrate` and drizzle-kit (schema/).
PG_DATABASE_URL="postgresql://user:password@localhost:5432/links"
# Postgres (prod). Used by drizzle-kit with `DB_MODE=PROD`.
# PG_DATABASE_URL1="postgresql://user:password@prod-host:5432/links"
# Optional Postgres search path (default `public`).
# DATABASE_SCHEMA=public

# Redis (slug → URL cache). `redis://` or `rediss://` (TLS).
# Optional: without it every redirect reads Postgres.
REDIS_URL="rediss://default:password@host:6379"

# Better Auth server (tsc-users). The Rust API forwards the request cookie to
# `${PUBLIC_BETTER_AUTH_URL}/api/auth/get-session`; the frontend's auth client
# talks to it directly.
PUBLIC_BETTER_AUTH_URL="http://localhost:5188"
