{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "bun install",
	"buildCommand": "bun run --cwd frontend build",
	"outputDirectory": "frontend/build",
	"regions": ["sin1"],
	"functions": {
		"api/vercel.rs": {
			"maxDuration": 30,
			"regions": ["sin1"]
		}
	},
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "/api/vercel"
		},
		{
			"source": "/:slug",
			"destination": "/api/vercel"
		},
		{
			"source": "/:slug/",
			"destination": "/api/vercel"
		}
	]
}
