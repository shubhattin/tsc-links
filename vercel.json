{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "bun run --cwd frontend build",
  "outputDirectory": "frontend/build",
  "regions": ["bom1"],
  "functions": {
    "api/vercel.rs": {
      "maxDuration": 30,
      "regions": ["bom1"]
    }
  },
  "rewrites": [
    {
      "source": "/expenses",
      "destination": "/expenses.html"
    },
    {
      "source": "/expenses/",
      "destination": "/expenses.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/vercel"
    },
    {
      "source": "/:slug",
      "destination": "/api/vercel"
    },
    {
      "source": "/:slug/",
      "destination": "/api/vercel"
    }
  ]
}
